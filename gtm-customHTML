<script>

window.addEventListener("message", function(event) {

  if (!event.data) return;

  if (
    event.data.type === "hsCallsToActionCallback" &&
    event.data.eventName === "onCallToActionFormSubmitted"
  ) {

    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({
      event: "hubspot_form_submit",
      formId: event.data.data.formId || "",
      ctaId: event.data.id || "",
      submissionValues: event.data.data.submissionValues || {}
    });

    console.log("HubSpot CTA form submitted", event.data);
  }

});
</script>
